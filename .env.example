# Copy to .env. Never commit a real key.
PORT=3100
HOST=127.0.0.1
# snapshot (default) or metrapi. Explicit activation required for live requests.
DATA_MODE=snapshot
METRAPI_API_KEY=
# Path relative to repository root; file stays outside Git.
SNAPSHOT_PATH=test_spb_sale.jsonl
# If this catalog exists, it takes priority over the small JSONL snapshot.
CATALOG_PATH=data/catalog.sqlite
# rules (default) or ollama. No paid/cloud adapter is enabled.
EXTRACTOR_MODE=rules
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# 1 = more accurate reasoning (slower), 0 = experimental fast mode
OLLAMA_THINK=1
